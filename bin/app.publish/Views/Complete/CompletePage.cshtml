                    </div>

                    <br />

                    <div class="row" style="background-color: aliceblue">
                        <h6><span>Requirements details</span></h6>
                        <div class="col">
                            Company Registration
                            <div>
                                <label style="color:blue">@ViewBag.NewTender.comp_reg</label>
                            </div>
                        </div>
                        <div class="col">
                            Energy Types(s)
                            <div>
                                <label style="color:blue">
                                @ViewBag.ReqEnergyTyp
                                </label>
                            </div>
                        </div>
                        <div class="col">
                            Contract Duration (s)
                            <div>
                                <label style="color:blue">@ViewBag.Requirements.ContractDuration</label>
                            </div>
                        </div>
                        <div class="col">
                            Payment Terms (s)
                            <div>
                                <label style="color:blue">@ViewBag.Requirements.PaymentTerms</label>
                            </div>
                        </div>
                        <div class="col">
                            Contract Types
                            <div>
                                <label style="color:blue">@ViewBag.Requirements.ContractType</label>
                            </div>
                        </div>
                        <div class="col">
                            Included Commission
                            <div>
                                <label style="color:blue">@ViewBag.Requirements.IncludedCommission</label>
                            </div>
                        </div>
                    </div>
                    <div class="row" style="background-color: aliceblue">
                        <div class="col">
                            Payment Durations (s)
                            <div>
                                <label style="color:blue">@ViewBag.Requirements.PaymentDuration</label>
                            </div>
                        </div>
                        <div class="col">
                            Contract Start Date
                            <div>
                                <label style="color:blue">@ViewBag.Requirements.Contract_startdate</label>
                            </div>
                        </div>
                        <div class="col">
                            Contract End Date
                            <div>
                                <label style="color:blue">@ViewBag.Requirements.Contract_enddate</label>
                            </div>
                        </div>
                        <div class="col">
                            DC/DA Agent
                            <div>
                                <label style="color:blue">@ViewBag.Requirements.Dcda_agent</label>
                            </div>
                        </div>
                        <div class="col">
                            Submission Deadline
                            <div>
                                <label style="color:blue">@ViewBag.Requirements.Submission_deadline</label>
                            </div>
                            @*Back by Date
                <div>
                    <label style="color:blue">@ViewBag.Requirements.Backbydate</label>
                </div>*@
                        </div>
                        <div class="col">
                            Submission Email
                            <div>
                                <label style="color:blue">@ViewBag.Notes.notes</label>
                            </div>
                            @*Billing
                            <div>
                                <label style="color:blue">@ViewBag.Requirements.Billing</label>
                            </div>*@
                        </div>
                    </div>
                    <br />
                    <div class="row">
                        <h6><span>Supplier Details</span></h6>
                        <div class="col">
                            Supplier
                            <div>
                                <label style="color:blue">@ViewBag.Supplier</label>
                            </div>
                        </div>
                        <div class="col">
                            Invitation to Tender
                            <div>
                                <label style="color:blue">@ViewBag.SupplierList.InvitationToTender</label>
                            </div>
                        </div>
                        <div class="col">
                            Email Id's
                            <div>
                                <label style="color:blue">@ViewBag.SupplierList.EmailIds</label>
                            </div>
                        </div>
                        <div class="col">
                        </div>
                        <div class="col">
                        </div>
                        <div class="col">
                        </div>
                    </div>
                    <br />
                    <div class="row" style="background-color: aliceblue">
                        <h6><span>Contract Duration</span></h6>
                        <div class="col">
                            Contract Start Date
                        </div>
                        <div class="col">
                            Conytract End Date
                        </div>
                        <div class="col">
                            Duration in days
                        </div>
                        <div class="col">
                        </div>
                        <div class="col">
                        </div>
                        <div class="col">
                        </div>
                    </div>
                    <div class="row" style="background-color: aliceblue">
                        @{
                            foreach (var itm in @ViewBag.ContractDuration)
                            {
                                <div class="col">
                                    @itm.StartDate
                                </div>
                                <div class="col">
                                    @itm.EndDate
                                </div>
                                <div class="col">
                                    @itm.Duration
                                </div>
                                <div class="col">
                                </div>
                                <div class="col">
                                </div>
                                <div class="col">
                                </div>
                            }
                        }
                    </div>

                    <br />

                    <div class="row">
                        <h6><span>Files uploaded details</span></h6>
                        @{
                            foreach (var itm in ViewBag.Uploads)
                            {
                                <div class="col">
                                    @itm.heading
                                    <div>
                                        <label style="color:blue">@itm.upload_file</label>
                                    </div>
                                </div>
                            }
                        }
                        <div class="col">
                        </div>
                    </div>

                    <div class="row">
                        <h6><span>Location / Meter uploaded details</span></h6>
                        <div class="tableFixHead" style="height: 300px; overflow-x: auto;">
                            <table class="table-sm table-bordered table-striped mb-0 text-nowrap">
                                <thead>
                                    <tr>
                                        @{
                                            foreach (string header in @ViewBag.nhhHeader)
                                            {
                                                <th scope="col">@header</th>
                                            }
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @{
                                        foreach (var item in ViewBag.Analysis.TrnERMTenderDetails)
                                        {
                                            <tr>
                                                <td>@item.Location_Ref</td>
                                                <td>@item.Client_Ref</td>
                                                <td>@item.Address1</td>
                                                <td>@item.Address2</td>
                                                <td>@item.Address3</td>
                                                <td>@item.Address4</td>
                                                <td>@item.Address5</td>
                                                <td>@item.Postcode</td>
                                                <td>@item.Msn</td>
                                                <td>@item.Mpanfull</td>
                                                <td>@item.Profile</td>
                                                <td>@item.Mtc</td>
                                                <td>@item.Llf</td>
                                                <td>@item.Distributor_ID</td>
                                                <td>@item.Mpan_Core</td>
                                                <td>@item.Mpan_Status</td>
                                                <td>@item.Day_kWh</td>
                                                <td>@item.Night_kWh</td>
                                                <td>@item.Evening_kWh</td>
                                                <td>@item.Peak_kWh</td>
                                                <td>@item.OffPeak_kWh</td>
                                                <td>@item.Total_kWh</td>
                                                <td>@item.kVa</td>
                                                <td>@item.Start_Date</td>
                                                <td>@item.Payment_Method</td>
                                                <td>@item.Payment_Duration</td>
                                                <td>@item.Supplier</td>
                                                <td>@item.LastBill_Date</td>
                                                <td>@item.LastBill_Date_Supplier</td>
                                                <td>@item.StandingCharge_penceorday</td>
                                                <td>@item.DayRate</td>
                                                <td>@item.NightRate</td>
                                                <td>@item.EveningRate</td>
                                                <td>@item.AvailRate</td>
                                                <td>@item.PeakDecjan</td>
                                                <td>@item.PeakNovfeb</td>
                                                <td>@item.PeakOther</td>
                                                <td>@item.OffPeak</td>
                                                <td>@item.Other</td>
                                                <td>@item.MeteringCharge_penceorday</td>
                                                <td>@item.COMMSCharge_penceorday</td>
                                                <td>@item.SettlementAgencyCharge_penceorday</td>
                                                <td>@item.MeterAdministratorAgentCharge_penceorday</td>
                                                <td>@item.NonEnergy_penceorday</td>
                                                <td>@item.UMSCharge_penceorday</td>
                                                <td>@item.TNUosFixedDailyCharge_penceorday</td>
                                                <td>@item.IntelligentAnalytics_penceorday</td>
                                                <td>@item.RenewableObligation_penceorday</td>
                                                <td>@item.NuclearRABLevy_penceorday</td>
                                                <td>@item.AMRCharge_penceorday</td>
                                                <td>@item.MeterAssetProviderMAPCharge_penceorday</td>
                                                <td>@item.DataCollectorDataAggregator_penceorday</td>
                                                <td>@item.MSPUnitCharge_penceorday</td>
                                                <td>@item.MeterServiceAdvancedCharge_penceorday</td>
                                                <td>@item.SiteFee_penceorday</td>
                                                <td>@item.DayAheadPremium_penceorday</td>
                                                <td>@item.REGO_penceorday</td>
                                                <td>@item.CfdCharge_penceorday</td>
                                                <td>@item.GreengasLevyCharge_penceorday</td>
                                                <td>@item.DataServicesAdvanced_penceorday</td>
                                                <td>@item.Remarks</td>
                                                <td>@item.ERMRemarks</td>
                                            </tr>
                                        }
                                    }

                                </tbody>
                            </table>
                        </div>
                    </div>
                    </div>
                </div>
        </div>
        <div class="card-footer text-muted">
            @if (TempData["INFO"] != null)
            {
                <p>Information: <font color="green">@TempData["INFO"]</font></p>
            }
            else if (TempData["ERROR"] != null)
            {
                <p>Information: <font color="red">@TempData["ERROR"]</font></p>
            }
        </div>
    </div>


    <script type="text/javascript">

        function next()
        {
            document.getElementById("newReq").value = "Next";
            alert("innext");
        }

        function previous() {
            document.getElementById("newReq").value = "Previous";
            alert("in prev");

        }

    </script>
</main>
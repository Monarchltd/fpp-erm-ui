
@{
    ViewBag.Title = "Complete";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/css/bootstrap-datepicker.min.css" />
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/js/bootstrap-datepicker.min.js"></script>

<style>
    .tableFixHead {
        overflow: auto;
        height: 100px;
    }

        .tableFixHead thead th {
            position: sticky;
            top: 0;
            z-index: 1;
        }

    /* Just common table stuff. Really. */
    table {
        border - collapse: collapse;
        width: 100%;
    }

    th, td {
        padding: 8px 16px;
    }

    th {
        background: #eee;
    }

    h6 {
        width: 100%;
        text-align: center;
        border-bottom: 1px solid #000;
        line-height: 0.1em;
    }

    h6 span {
        background: #fff;
        padding: 0 10px;
    }
</style>

<main aria-labelledby="title">
    <div class="card text-left">
        <div class="card-header">
            <h5 class="card-title">Complete</h5>
            Tender Id: <font color="brown">@ViewBag.NewTender.id</font>
        </div>
        <div class="card-body">
            <button type="button" class="btn btn-success btn-sm">@Html.ActionLink("Close", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</button>
            <br /> <br />
            <!-- Nav tabs -->
            <ul class="nav nav-tabs">
                <li class="nav-item">
                    <a class="nav-link disabled">Upload</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link disabled">Analysis</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link disabled">Requirements</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active"  data-toggle="tab" href="#completed">Completed</a>
                </li>
            </ul>

            <!-- Tab panes -->
            <div class="tab-content">
                <div id="upload" class="container tab-pane fade">
                    <br>
                </div>

                <div id="analysis" class="container tab-pane fade">
                    <br>
                </div>

                <div id="requirements" class="container tab-pane fade">
                </div>
                <div id="completed" class="container tab-pane active">
                    <br>
                    <div class="row" style="background-color:aliceblue">
                        <h6><span>Upload details</span></h6>
                        <div class="col">
                            Half Hourly / Non Half Hourly / Gas
                        </div>
                        <div class="col">
                            Commissions
                        </div>
                        <div class="col">
                            Current Supplier
                        </div>
                        <div class="col">
                            Company Reg
                        </div>
                        <div class="col">
                            Newlon DPS
                        </div>
                        <div class="col">
                        </div>
                    </div>
                    <div class="row" style="background-color:aliceblue">
                        <div class="col">
                            <label style="color:blue">@ViewBag.HhnhhGas</label>
                        </div>
                        <div class="col">
                            <label style="color:blue">@ViewBag.NewTender.commission</label>
                        </div>
                        <div class="col">
                            <label style="color:blue">@ViewBag.CurrentSupplier</label>
                        </div>
                        <div class="col">
                            <label style="color:blue">@ViewBag.NewTender.comp_reg</label>
                        </div>
                        <div class="col">
                            <label style="color:blue">@ViewBag.NewTender.newlondps</label>
                        </div>
                        <div class="col">
                        </div>
                    </div>

                    <div class="row" style="background-color: aliceblue">
                        <div class="col">
                            Fuel Type
                            <div>
                                <label style="color:blue">@ViewBag.FuelType</label>
                            </div>
                        </div>
                        <div class="col">
                            End Date / Length
                            <div>
                                <label style="color:blue">@ViewBag.NewTender.enddatelength</label>
                            </div>
                        </div>
                        <div class="col">
                            Analysis AQ
                            <div>
                                <label style="color:blue">@ViewBag.NewTender.analysisaq</label>
                            </div>
                        </div>
                        <div class="col">
                            Matrix Pricing
                            <div>
                                <label style="color:blue">@ViewBag.NewTender.fillers</label>
                            </div>
                        </div>
                        <div class="col">
                            MOP Agreement in place
                            <div>
                                <label style="color:blue">@ViewBag.NewTender.mopagreement</label>
                            </div>
                        </div>
                        <div class="col">
                            CNB No
                            <div>
                                <label style="color:blue">@ViewBag.NewTender.supplytype</label>
                            </div>
                        </div>
                    </div>
                    <br />

                    <div class="row">
                        <h6><span>Analysis details</span></h6>
                        <div class="row">
                            <div class="col">
                                Client
                                <p>@ViewBag.Analysis.MasErmNetworkModel.name</p>
                            </div>
                            <div class="col">
                                Consultant
                                <p>@ViewBag.Analysis.consultantname</p>
                            </div>
                            <div class="col">
                                Email
                                <p>@ViewBag.Analysis.consultantemail</p>
                            </div>
                            <div class="col">
                                Head Office
                                <p>@ViewBag.Analysis.MasErmNetworkModel.headaddress1</p>
                            </div>
                            <div class="col">
                                Address
                                <p>@ViewBag.Analysis.MasErmNetworkModel.corraddress1</p>
                            </div>
                            <div class="col">
                            </div>
                        </div>

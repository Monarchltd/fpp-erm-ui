
@{
    ViewBag.Title = "New Tender";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

<style>
    .tableFixHead          { overflow: auto; height: 100px; }
    .tableFixHead thead th { position: sticky; top: 0; z-index: 1; }

    /* Just common table stuff. Really. */
    table  { border - collapse: collapse; width: 100%; }
    th, td { padding: 8px 16px; }
    th     { background: #eee; }
</style>

<main aria-labelledby="title">
    <div class="card text-left">
        <div class="card-header">
            <h5 class="card-title">New Tender</h5>
            Tender Id: <font color="brown">@ViewBag.TenderId</font>
        </div>
        <div class="card-body">
            <button type="button" class="btn btn-warning btn-sm">@Html.ActionLink("Cancel", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</button>
            <br /> <br />
            <!-- Nav tabs -->
            <ul class="nav nav-tabs">
                <li class="nav-item">
                    <a class="nav-link disabled">Upload</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link active" data-toggle="tab" href="#analysis">Analysis</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link disabled">Requirements</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link disabled">Completed</a>
                </li>
            </ul>

            <!-- Tab panes -->
            <div class="tab-content">
                <div id="upload" class="container tab-pane fade">
                    <br>
                </div>

                <div id="analysis" class="container tab-pane active">
                    <br>
                    <form method="post">
                        <table class="table-sm">
                            <tr>
                                <th class="bg-light">@ViewBag.Analysis.MasErmClientModel.name ( @ViewBag.Supplytype )</th>
                            </tr>
                        </table>

                        <div class="row">
                            <div class="col">
                                Client
                                <p>@ViewBag.Analysis.MasErmNetworkModel.name</p>
                            </div>
                            <div class="col">
                                Consultant
                                <p>@ViewBag.Analysis.consultantname</p>
                            </div>
                            <div class="col">
                                Email
                                <p>@ViewBag.Analysis.consultantemail</p>
                            </div>
                            <div class="col">
                                Head Office
                                <p>@ViewBag.Analysis.MasErmNetworkModel.headaddress1</p>
                            </div>
                        </div>
                        <div class="row">
                            <p>Address: @ViewBag.Analysis.MasErmNetworkModel.corraddress1</p>
                        </div>

                        <div class="row">
                            <div class="tableFixHead" style="height: 300px; overflow-x: auto;">
                                <table class="table-sm table-bordered table-striped mb-0 text-nowrap">
                                    <thead>
                                        <tr>
                                            @{
                                                foreach (string header in @ViewBag.nhhHeader)
                                                {
                                                    <th scope="col">@header</th>
                                                }
                                            }
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @{
                                            foreach (var item in ViewBag.Analysis.TrnERMTenderDetails)
                                            {
                                            <tr>
                                                <td>@item.Location_Ref</td>
                                                <td>@item.Client_Ref</td>
                                                <td>@item.Address1</td>
                                                <td>@item.Address2</td>
                                                <td>@item.Address3</td>
                                                <td>@item.Address4</td>
                                                <td>@item.Address5</td>
                                                <td>@item.Postcode</td>
                                                <td>@item.Msn</td>
                                                <td>@item.Mpanfull</td>
                                                <td>@item.Profile</td>
                                                <td>@item.Mtc</td>
                                                <td>@item.Llf</td>
                                                <td>@item.Distributor_ID</td>
                                                <td>@item.Mpan_Core</td>
                                                <td>@item.Mpan_Status</td>
                                                <td>@item.Day_kWh</td>
                                                <td>@item.Night_kWh</td>
                                                <td>@item.Evening_kWh</td>
                                                <td>@item.Peak_kWh</td>
                                                <td>@item.OffPeak_kWh</td>
                                                <td>@item.Total_kWh</td>
                                                <td>@item.kVa</td>
                                                <td>@item.Start_Date</td>
                                                <td>@item.Payment_Method</td>
                                                <td>@item.Payment_Duration</td>
                                                <td>@item.Supplier</td>
                                                <td>@item.LastBill_Date</td>
                                                <td>@item.LastBill_Date_Supplier</td>
                                                <td>@item.StandingCharge_penceorday</td>
                                                <td>@item.DayRate</td>
                                                <td>@item.NightRate</td>
                                                <td>@item.EveningRate</td>
                                                <td>@item.AvailRate</td>
                                                <td>@item.PeakDecjan</td>
                                                <td>@item.PeakNovfeb</td>
                                                <td>@item.PeakOther</td>
                                                <td>@item.OffPeak</td>
                                                <td>@item.Other</td>
                                                <td>@item.MeteringCharge_penceorday</td>
                                                <td>@item.COMMSCharge_penceorday</td>
                                                <td>@item.SettlementAgencyCharge_penceorday</td>
                                                <td>@item.MeterAdministratorAgentCharge_penceorday</td>
                                                <td>@item.NonEnergy_penceorday</td>
                                                <td>@item.UMSCharge_penceorday</td>
                                                <td>@item.TNUosFixedDailyCharge_penceorday</td>
                                                <td>@item.IntelligentAnalytics_penceorday</td>
                                                <td>@item.RenewableObligation_penceorday</td>
                                                <td>@item.NuclearRABLevy_penceorday</td>
                                                <td>@item.AMRCharge_penceorday</td>
                                                <td>@item.MeterAssetProviderMAPCharge_penceorday</td>
                                                <td>@item.DataCollectorDataAggregator_penceorday</td>
                                                <td>@item.MSPUnitCharge_penceorday</td>
                                                <td>@item.MeterServiceAdvancedCharge_penceorday</td>
                                                <td>@item.SiteFee_penceorday</td>
                                                <td>@item.DayAheadPremium_penceorday</td>
                                                <td>@item.REGO_penceorday</td>
                                                <td>@item.CfdCharge_penceorday</td>
                                                <td>@item.GreengasLevyCharge_penceorday</td>
                                                <td>@item.DataServicesAdvanced_penceorday</td>
                                                <td>@item.Remarks</td>
                                                <td>@item.ERMRemarks</td>
                                            </tr>
                                            }
                                        }

                                    </tbody>
                                </table>
                            </div>
                        </div>



                        <div class="row">
                            <div class="col">
                            </div>
                            <div class="col">
                            </div>
                            <div class="col">
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col">
                            </div>
                            <div class="col">
                            </div>
                            <div class="col">
                            </div>
                        </div>
                        <div class="row">
                            <div class="col">
                                <button href="#" class="btn btn-info btn-sm" type="submit" formaction="@Url.Action("NewTender", "Tenders")">< Previous</button>
                            </div>
                            <div class="col">
                            </div>
                            <div class="col">
                                @{
                                    if (@ViewBag.Nextpage != null)
                                    {
                                        if (@ViewBag.Nextpage == "true")
                                        {
                                            <button href="#" class="btn btn-info btn-sm" type="submit" formaction="@Url.Action("NewRequirements", "Requirements")">Next ></button>
                                        }
                                    }
                                }
                            </div>
                        </div>
                    </form>
                </div>

                <div id="requirements" class="container tab-pane fade">
                    <br>
                </div>
                <div id="completed" class="container tab-pane fade">
                    <br>
                </div>
            </div>
        </div>
        <div class="card-footer text-muted">
            @if (TempData["INFO"] != null)
            {
                <p>Information: <font color="green">@TempData["INFO"]</font></p>
            }
            else if (TempData["ERROR"] != null)
            {
                <p>Information: <font color="red">@TempData["ERROR"]</font></p>
            }

            @{ 
                if (@ViewBag.Errors != null)
                {
                    foreach(string err in @ViewBag.Errors)
                    {
                        <p style="color:red">@err</p>
                    }
                }
            }

        </div>
    </div>
</main>
<form method="post">

    <input type="hidden" name="tenderId" value="@TempData["TenderId"]" />
    <input type="hidden" name="notesUpdate" value="false" />
    <input type="hidden" name="statusUpdate" value="false" />

    <main>

        <div class="card text-left">
            <div class="card-header">
                <h5 class="card-title">Tenders View</h5>
            </div>
            <div class="card-body">
                <div class="input-group input-group-sm mb-5">
                    <div class="input-group-prepend">
                        <span class="input-group-text" id="inputGroup-sizing-sm">Search Tender Id / CNB No</span>
                    </div>
                    <input type="text" class="form-control" aria-label="Small" aria-describedby="inputGroup-sizing-sm">
                    <button type="button" class="btn btn-outline-dark">Search</button>
                    &nbsp;&nbsp;
                    <button type="button" class="btn btn-outline-primary">@Html.ActionLink("+ New Tender", "NewTender", "Tenders", new { area = "" }, new { @class = "nav-link" })</button>
                    &nbsp;&nbsp;
                    <span class="input-group-text" id="inputGroup-sizing-sm">Pages</span>
                    <select class="form-control" onchange="pages();" id="index_page">
                        <option selected>1</option>
                        <option>2</option>
                    </select>
                </div>

                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th scope="col">Tender Id</th>
                            <th scope="col">Client Name</th>
                            <th scope="col">Supplier</th>
                            <th scope="col">Type</th>
                            <th scope="col">CNB No</th>
                            <th scope="col">Consultant Name</th>
                            <th scope="col">Commission</th>
                            <th scope="col">Status</th>
                            <th scope="col">Version</th>
                            <th scope="col">Created User</th>
                            <th scope="col">Created Date</th>
                            <th scope="col">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.Tenders != null)
                        {
                            foreach (var item in ViewBag.Tenders)
                            {
                                <tr>
                                    <th scope="row">@item.id</th>
                                    <td>@item.MasErmNetworkModel_s.name</td>
                                    <td>@item.MasErmSupplierModel_s.name</td>
                                    <td>@item.MasErmTenderModel_s.supplytype</td>
                                    <td>@item.CnbNo</td>
                                    <td>@item.MasErmTenderModel_s.consultantname</td>
                                    <td>@item.MasErmTenderModel_s.commission (@item.MasErmTenderModel_s.commission_type)</td>
                                    <td>@item.TrnERMTenderStatus_s.StatusDesc</td>
                                    <td>@item.VersionId</td>
                                    <td>@item.CreatedBy</td>
                                    <td>@item.CreatedDate</td>
                                    <td>
                                        <div>
                                            <button type="submit" title="Notes" class="btn btn-transparent btn-sm" formaction="@Url.Action("NotesPage", "Notes")" onclick="notesDialog(@item.id);"><span class="bi bi-chat-quote"></span></button>
                                            <button type="submit" data-toggle="tooltip" title="Status" class="btn btn-transparent btn-sm" formaction="@Url.Action("StatusPage", "Status")" onclick="statusDialog(@item.id);"><i class="bi bi-person"></i></button>
                                            @{
                                                if (@item.TrnERMTenderStatus_s.StatusDesc != "Tender_Sent")
                                                {

                                                    <button type="submit" data-toggle="tooltip" title="Status" class="btn btn-transparent btn-sm" formaction="@Url.Action("SendMail", "Send")" onclick="submitView(@item.id);">

                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-send" viewBox="0 0 16 16">
                                                            <path d="M15.854.146a.5.5 0 0 1 .11.54l-5.819 14.547a.75.75 0 0 1-1.329.124l-3.178-4.995L.643 7.184a.75.75 0 0 1 .124-1.33L15.314.037a.5.5 0 0 1 .54.11ZM6.636 10.07l2.761 4.338L14.13 2.576zm6.787-8.201L1.591 6.602l4.339 2.76z" />
                                                        </svg>
                                                    </button>

                                                }
                                                else
                                                {
                                                    <button data-toggle="tooltip" title="Status" class="btn btn-success btn-sm">
                                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-send-dash" viewBox="0 0 16 16">
                                                            <path d="M15.964.686a.5.5 0 0 0-.65-.65L.767 5.855a.75.75 0 0 0-.124 1.329l4.995 3.178 1.531 2.406a.5.5 0 0 0 .844-.536L6.637 10.07l7.494-7.494-1.895 4.738a.5.5 0 1 0 .928.372zm-2.54 1.183L5.93 9.363 1.591 6.602z" />
                                                            <path d="M16 12.5a3.5 3.5 0 1 1-7 0 3.5 3.5 0 0 1 7 0m-5.5 0a.5.5 0 0 0 .5.5h3a.5.5 0 0 0 0-1h-3a.5.5 0 0 0-.5.5" />
                                                        </svg>
                                                    </button>

                                                }
                                            }

                                            <button data-toggle="tooltip" class="btn btn-transparent btn-sm"><span class="bi bi-files"></span></button>
                                            <button type="submit" data-toggle="tooltip" class="btn btn-transparent btn-sm" formaction="@Url.Action("ViewSend", "Send")" onclick="submitView(@item.id);"><span class="bi bi-eye-fill"></span></button>
                                            <button data-toggle="tooltip" class="btn btn-transparent btn-sm"><span class="bi bi-vector-pen"></span></button>
                                            <button data-toggle="tooltip" class="btn btn-danger btn-sm"><span class="bi bi-trash-fill"></span></button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>

                <!--NOTES-->
                <div class="modal fade" id="notesModal" role="dialog" aria-labelledby="notes" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content col-lg-3 col-md-4 col-sm-6">
                            <div class="modal-header">
                                <h5 class="modal-title">Notes&nbsp;&nbsp; ( Tender Id : @TempData["TenderId"])</h5>
                                @*<button type="button" class="close" data-dismiss="modal" aria-label="Close">
                                        <span aria-hidden="true">&times;</span>
                                    </button>*@
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <div class="col">
                                        Add new notes<br />
                                        <textarea class="form-control" style="min-width: 100%; resize:none" name="notesNew"></textarea>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col">
                                        History<br />
                                        <textarea class="form-control" style="min-width: 100%; resize: none;" rows="20" name="notesHistory" readonly>@TempData["History"]</textarea>
                                    </div>
                                </div>
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-sm btn-secondary" onclick="dismissModal()">Close</button>
                                <button type="submit" class="btn btn-sm btn-primary" formaction="@Url.Action("NotesPage", "Notes")" onclick="addNotes()">Add Notes</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!--STATUS-->
                <div class="modal fade" id="statusModal" role="dialog" aria-labelledby="status" aria-hidden="true">
                    <div class="modal-dialog" role="document">
                        <div class="modal-content col-lg-3 col-md-4 col-sm-6">
                            <div class="modal-header">
                                <h5 class="modal-title">Status Updates&nbsp;&nbsp; ( Tender Id : @TempData["TenderId"])</h5>
                            </div>
                            <div class="modal-body">
                                <div class="row">
                                    <div class="col">
                                        Status<br />
                                        <select class="form-select" name="statusId" aria-label="Default select example">
                                            @{
                                                foreach (var item in ViewBag.statusList)
                                                {
                                                    <option value="@item.Value">@item.Text</option>
                                                }
                                            }
                                        </select>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col">
                                        Status History<br />
                                        <textarea class="form-control" style="min-width: 100%; resize: none;" rows="20" name="statusHistory" readonly>@TempData["statusHistory"]</textarea>
                                    </div>
                                </div>

                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-sm btn-secondary" onclick="dismissStatusModal()">Close</button>
                                <button type="submit" class="btn btn-sm btn-primary" formaction="@Url.Action("StatusPage", "Status")" onclick="addStatus()">Submit</button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </div>
    </main>
</form>


<script type="text/javascript">

    const params = new URLSearchParams(document.location.search);
    const tenderid = params.get("tenderid");

    state = "@TempData["iconClicked"]";

    if (state == "notes")
        $(window).on('load', function () { $('#notesModal').modal('show'); });

    if (state == "status")
        $(window).on('load', function () { $('#statusModal').modal('show'); });

    function notesDialog(tender_id) {
        document.getElementsByName("tenderId")[0].value = tender_id;
    }

    function statusDialog(tender_id) {
        document.getElementsByName("tenderId")[0].value = tender_id;
    }

    function addNotes() {
        document.getElementsByName("notesUpdate")[0].value = "true";
    }

    function addStatus() {
        document.getElementsByName("statusUpdate")[0].value = "true";
    }

    function dismissModal()
    {
        $('#notesModal').modal('hide');
        document.getElementsByName("tenderId")[0].value = 0;
    }

    function dismissStatusModal() {
        $('#statusModal').modal('hide');
        document.getElementsByName("tenderId")[0].value = 0;
    }

    $(document).ready(function () {
        $('[data-toggle="tooltip"]').tooltip();
    });

    function submitView(tender_id)
    {
        document.getElementsByName("tenderId")[0].value = tender_id;
    }
</script>

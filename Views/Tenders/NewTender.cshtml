
@{
    ViewBag.Title = "New Tender";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>


<main aria-labelledby="title">


    <div class="card text-left">
        <div class="card-header">
            <h5 class="card-title">New Tender</h5>
            Tender Id: @{ if (@ViewBag.NewTender != null) { @ViewBag.NewTender.id; } }
        </div>
        <div class="card-body">
            <button type="button" class="btn btn-warning btn-sm">@Html.ActionLink("Cancel", "Index", "Home", new { area = "" }, new { @class = "nav-link" })</button>
            <br /> <br />
            <!-- Nav tabs -->
            <ul class="nav nav-tabs">
                <li class="nav-item">
                    <a class="nav-link active" data-toggle="tab" href="#upload">Upload</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link disabled">Analysis</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link disabled">Requirements</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link disabled">Completed</a>
                </li>
            </ul>

            <!-- Tab panes -->
            <div class="tab-content">
                <div id="upload" class="container tab-pane active">
                    <br>
                    @using (Html.BeginForm("readXLSX", "Analysis", FormMethod.Post, new { enctype = "multipart/form-data", @class = "was-validated" }))
                    {
                        <div class="row">
                            <div class="col">
                                <label for="formFileSm" class="form-label">CNB No</label>
                                <input class="form-control form-control-sm" id="formFileSm" name="cnbno" type="text" value="@{if (@ViewBag.NewTender != null) { @ViewBag.NewTender.uploadPage.cnbno }
                                    } ">
                                <div class="invalid-feedback">File upload, required !</div>
                            </div>
                            <div class="col">
                                Energy Type
                                <select class="form-select" name="supplyType" id="supplyType" aria-label="Default select example" onchange="tenderControll();">
                                    <option value="">Select</option>
                                    <option value="1" @{ if (@ViewBag.NewTender != null) { if (@ViewBag.NewTender.uploadPage.supplytype == "1") { @ViewBag.NewTender.isSelected  ; } }}>
                                        Electric - Half Hourly
                                    </option>
                                    <option value="2" @{ if (@ViewBag.NewTender != null) { if (@ViewBag.NewTender.uploadPage.supplytype == "2") { @ViewBag.NewTender.isSelected  ; } }}>
                                        Electric - Non Half Hourly
                                    </option>
                                    <option value="3" @{ if (@ViewBag.NewTender != null) { if (@ViewBag.NewTender.uploadPage.supplytype == "3") { @ViewBag.NewTender.isSelected  ; } }}>
                                        Gas
                                    </option>
                                </select>
                                <div class="invalid-feedback">Supply type, required !</div>
                            </div>
                            <div class="col">
                                Commissions
                                <div class="row">
                                    <div class="col">
                                        <div class="input-group mb-3">
                                            <div class="input-group-prepend">
                                                <span class="input-group-text" id="poundSign">£</span>
                                            </div>
                                            <input class="form-control form-control-sm" name="commissions" value="@{ if (@ViewBag.NewTender != null)
                                                { @ViewBag.NewTender.uploadPage.commissions;
                                                } } " required>
                                        </div>
                                        <div class="invalid-feedback">Commission, required !</div>
                                    </div>
                                    <div class="col">
                                        <select class="form-control form-control-sm" name="commissionstype" id="commType" aria-label="Default select example" style="width:180px;" onchange="changePoundsign();">
                                            <option value="1" @{ if (@ViewBag.NewTender != null) { if (@ViewBag.NewTender.uploadPage.commissions_type == "1") { @ViewBag.NewTender.isSelected  ; } }}>
                                                Commissions £/pa
                                            </option>
                                            <option value="2" @{ if (@ViewBag.NewTender != null) { if (@ViewBag.NewTender.uploadPage.commissions_type == "2") { @ViewBag.NewTender.isSelected  ; } }}>
                                                Commissions p/kwh
                                            </option>
                                        </select>
                                    </div>
                                </div>

                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col">
                                <div class="mb-3">
                                    <label for="formFileSm" class="form-label">Upload file having meters, consumption, pricing etc details</label>
                                    <input class="form-control form-control-sm" id="formFileSm" name="uploadedFile" type="file" text="@{ if (@ViewBag.NewTender != null) { @ViewBag.NewTender.uploadPage.uploadedFile; } }" required>
                                    <div class="invalid-feedback">File upload, required !</div>
                                </div>
                            </div>
                            <div class="col">
                                Newlon DPS
                                <select class="form-select" name="newlondps" aria-label="Default select example" required>
                                    <option value="">Select</option>
                                    <option value="N" @{ if (@ViewBag.NewTender != null) { if (@ViewBag.NewTender.uploadPage.newlondps == "N") { @ViewBag.NewTender.isSelected  ; } }}>No</option>
                                    <option value="Y" @{ if (@ViewBag.NewTender != null) { if (@ViewBag.NewTender.uploadPage.newlondps == "Y") { @ViewBag.NewTender.isSelected  ; } }}>Yes</option>
                                </select>
                                <div class="invalid-feedback">Newlon DPS, required !</div>
                                @*Company Reg
                    <input type="text" class="form-control" name="companyreg" value="@{ if (@ViewBag.NewTender != null) { @ViewBag.NewTender.uploadPage.companyreg; } }" required>
                    <div class="invalid-feedback">
                        Company registration, required !
                    </div>*@
                            </div>
                            <div class="col">
                                Fuel Type<br />
                                @*<select class="form-select" name="fueltype" aria-label="Default select example" required>
            <option value="">Select</option>
            <option value="B" @{ if (@ViewBag.NewTender != null) { if (@ViewBag.NewTender.uploadPage.fueltype == "B") { @ViewBag.NewTender.isSelected  ; } }}>Both</option>
            <option value="E" @{ if (@ViewBag.NewTender != null) { if (@ViewBag.NewTender.uploadPage.fueltype == "E") { @ViewBag.NewTender.isSelected  ; } }}>Brown</option>
            <option value="G" @{ if (@ViewBag.NewTender != null) { if (@ViewBag.NewTender.uploadPage.fueltype == "G") { @ViewBag.NewTender.isSelected  ; } }}>Green</option>
        </select>*@
                                <input class="form-check-input" type="checkbox" value="BR" name="fueltype_brown" @{ if (@ViewBag.NewTender != null) { if (@ViewBag.NewTender.uploadPage.fueltype_brown == "BR") { @ViewBag.NewTender.isChecked  ; } }}>
                                <label class="form-check-label" for="fueltype_brown">Brown</label>&nbsp;
                                <input class="form-check-input" type="checkbox" value="GR" name="fueltype_green" @{ if (@ViewBag.NewTender != null) { if (@ViewBag.NewTender.uploadPage.fueltype_green == "GR") { @ViewBag.NewTender.isChecked  ; } }}>
                                <label class="form-check-label" for="fueltype_green">Green</label>&nbsp;
                                <input class="form-check-input" type="checkbox" value="CA" name="fueltype_carbon" @{ if (@ViewBag.NewTender != null) { if (@ViewBag.NewTender.uploadPage.fueltype_carbon == "CA") { @ViewBag.NewTender.isChecked  ; } }}>
                                <label class="form-check-label" for="fueltype_carbon">Carbon Zero Gas - Ecotricity</label>
                                <input class="form-check-input" type="checkbox" value="SG" name="fueltype_selectgreen" @{ if (@ViewBag.NewTender != null) { if (@ViewBag.NewTender.uploadPage.fueltype_selectgreen == "SG") { @ViewBag.NewTender.isChecked  ; } }}>
                                <label class="form-check-label" for="fueltype_carbon">Select Green</label>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col">
                                Analysis AQ
                                <select class="form-select" name="analysisaq" aria-label="Default select example" required>
                                    <option value="">Select</option>
                                    <option value="MONAR" @{ if (@ViewBag.NewTender != null) { if (@ViewBag.NewTender.uploadPage.analysisaq == "MONAR") { @ViewBag.NewTender.isSelected  ; } }}>Monarch</option>
                                    <option value="SUPPL" @{ if (@ViewBag.NewTender != null) { if (@ViewBag.NewTender.uploadPage.analysisaq == "SUPPL") { @ViewBag.NewTender.isSelected  ; } }}>Supplier</option>
                                    <option value="HHDAT" @{ if (@ViewBag.NewTender != null) { if (@ViewBag.NewTender.uploadPage.analysisaq == "HHDAT") { @ViewBag.NewTender.isSelected  ; } }}>Half-Hourly Data</option>
                                </select>
                                <div class="invalid-feedback">Analysis AQ, required !</div>
                            </div>
                            <div class="col">
                                Matrix Pricing
                                <select class="form-select" name="fillers" aria-label="Default select example" required>
                                    <option value="">Select</option>
                                    <option value="N" @{ if (@ViewBag.NewTender != null) { if (@ViewBag.NewTender.uploadPage.fillers == "N") { @ViewBag.NewTender.isSelected  ; } }}>No</option>
                                    <option value="Y" @{ if (@ViewBag.NewTender != null) { if (@ViewBag.NewTender.uploadPage.fillers == "Y") { @ViewBag.NewTender.isSelected  ; } }}>Yes</option>
                                </select>
                                <div class="invalid-feedback">Fillers, required !</div>
                                @*End Date / Length
                    <input class="form-control form-control-sm" name="enddatelength" value="@{ if (@ViewBag.NewTender != null) { @ViewBag.NewTender.uploadPage.enddatelength; } }" required>
                    <div class="invalid-feedback">End date/length, required !</div>*@
                            </div>
                            <div class="col">
                                MOP Agreement in place
                                <select class="form-select" name="mopagreement" aria-label="Default select example" required>
                                    <option value="">Select</option>
                                    <option value="N" selected>No</option>
                                    <option value="Y">Yes</option>
                                </select>
                                <div class="invalid-feedback">MOP agreement, required !</div>
                            </div>
                        </div>
                        <br />
                        <div class="row">
                            <div class="col">
                            </div>
                            <div class="col">
                            </div>
                            <div class="col">
                                <button href="#" type="submit" class="btn btn-info btn-sm" onclick="ShowProgress()">Next ></button>
                            </div>
                        </div>
                    }
                </div>

                <div id="analysis" class="container tab-pane fade">
                    <br>
                </div>
                <div id="requirements" class="container tab-pane fade">
                    <br>
                </div>
                <div id="completed" class="container tab-pane fade">
                    <br>
                </div>
            </div>

        </div>
        <div class="card-footer text-muted">
            <div class="row">
                <div class="col">
                    @if (TempData["INFO"] != null)
                    {
                        <p>Information: <font color="green">@TempData["INFO"]</font></p>
                    }
                    else if (TempData["ERROR"] != null)
                    {
                        <p>Information: <font color="red">@TempData["ERROR"]</font></p>
                    }
                    <p>Information: <font color="green">@TempData["INFO"]</font></p>
                </div>
                <div class="col">
                </div>
                <div class="col">
                </div>
            </div>

        </div>
    </div>


    <script type="text/javascript">

        //document.getElementById("loader").style.display = "none";

        if (document.getElementById("commType").value == 1) {
            document.getElementById("poundSign").textContent = "$";
        }
        else {
            document.getElementById("poundSign").textContent = ".";
        }

        function ShowProgress() {
            document.getElementById("loader").style.display = "block";

        };

        function changePoundsign()
        {

            if (document.getElementById("commType").value == 1) {
                document.getElementById("poundSign").textContent = "$";
            }
            else {
                document.getElementById("poundSign").textContent = ".";
            }
        }

    </script>

</main>

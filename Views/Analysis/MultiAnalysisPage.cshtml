
@{
    ViewBag.Title = "View";
    Layout = "~/Views/Shared/_Layout.cshtml";
}
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.slim.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/popper.js@1.16.1/dist/umd/popper.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@4.6.2/dist/js/bootstrap.bundle.min.js"></script>

<link rel="stylesheet" type="text/css" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/css/bootstrap-datepicker.min.css" />
<script type="text/javascript" src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-datepicker/1.10.0/js/bootstrap-datepicker.min.js"></script>

<style>
    .tableFixHead {
        overflow: auto;
        height: 100px;
    }

        .tableFixHead thead th {
            position: sticky;
            top: 0;
            z-index: 1;
        }

    /* Just common table stuff. Really. */
    table {
        border - collapse: collapse;
        width: 100%;
    }

    th, td {
        padding: 8px 16px;
    }

    th {
        background: #eee;
    }

    h6 {
        width: 100%;
        text-align: center;
        border-bottom: 1px solid #000;
        line-height: 0.1em;
    }

        h6 span {
            background: #fff;
            padding: 0 10px;
        }
</style>

<main aria-labelledby="title">
    @using (Html.BeginForm("MultiAnalysisPage", "Analysis", FormMethod.Post, new { enctype = "multipart/form-data", @class = "was-validated" }))
    {

        <div class="card text-left">
            <div class="card-header">
                <h5 class="card-title">Multi Supplier Analysis</h5>
                <div class="row">
                    <div class="col">
                    </div>
                    <div class="col">
                    </div>
                </div>
            </div>
            <div class="card-body">
                <div class="input-group input-group-sm mb-5">
                    <div class="input-group-prepend">
                        <span class="input-group-text" id="inputGroup-sizing-sm">Select Energy Type</span>
                    </div>
                    <select class="form-control" name="supplytype">
                       <option @{ if (ViewBag.SupplyType == "HH") { @ViewBag.SuppTypeSelected }}>HH</option>
                       <option @{ if (ViewBag.SupplyType == "NHH") { @ViewBag.SuppTypeSelected }}>NHH</option>
                       <option @{ if (ViewBag.SupplyType == "Gas") { @ViewBag.SuppTypeSelected }}>Gas</option>
                    </select>
              &nbsp;&nbsp;
                    <button type="submit" class="btn btn-outline-dark" formaction="@Url.Action("MultiAnalysisPage", "Analysis", new { searchclick = 1 })">Search</button>
                    &nbsp;&nbsp;
                    <button class="btn btn-primary">Run Analysis Report</button>
                </div>

                <table class="table table-sm table-hover">
                    <thead>
                        <tr>
                            <th scope="col">CNB No</th>
                            <th scope="col">Client Name</th>
                            <th scope="col">Supplier</th>
                            <th scope="col">Type</th>
                            <th scope="col">Status</th>
                            @*<th scope="col">Version</th>*@
                            <th scope="col">Created User</th>
                            <th scope="col">Created Date</th>
                            <th scope="col">Analysis Avail.</th>
                            <th scope="col">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (ViewBag.Tenders != null)
                        {
                            foreach (var item in ViewBag.Tenders)
                            {
                                <tr>
                                    <td>@item.cnbno</td>
                                    <td>@item.networkname</td>
                                    <td>@item.suppliername</td>
                                    <td>@item.suppliertype</td>
                                    <td>@item.statusdesc</td>
                                    @*<td>@item.versionid</td>*@
                                    <td>@item.createdby</td>
                                    <td>@item.createddate</td>
                                    <td>
                                        @{
                                            if (@item.analysisAvail == "Yes")
                                            {
                                                <button class="btn btn-success btn-sm">Yes</button>
                                            }
                                            else
                                            {
                                                <button class="btn btn-outline-dark btn-sm">No</button>
                                            }
                                        }
                                    </td>
                                    <td>
                                        @{
                                            if (@item.button_desc == "Add")
                                            {
                                                <button id="add" class="btn btn-dark btn-sm" formaction="@Url.Action("MultiAnalysisPage", "Analysis", new { suppId = @item.id })" 
                                                @{ 
                                                    if (@item.analysisAvail == "No")
                                                    {
                                                        @ViewBag.ActionDisabled
                                                    }
                                                }>&nbsp;+&nbsp;</button>
                                            }
                                            else
                                            {
                                    <button id="add" class="btn btn-danger btn-sm" formaction="@Url.Action("MultiAnalysisPage", "Analysis", new { suppIdremove = @item.id })">&nbsp;-&nbsp;</button>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    <div class="card-footer text-muted">
    @{ 
        if (@ViewBag.Message != null)
        {
            <label>@ViewBag.Message</label>
        }
    }

    </div>

    }

    <script type="text/javascript">

    </script>
</main>
